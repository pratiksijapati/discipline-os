# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://discipline_user:YOUR_APP_PASSWORD@localhost:5432/discipline_os

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Web Push reminders — generate with: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: secret for an external cron calling POST /api/notifications/run/
REMINDER_CRON_SECRET=
